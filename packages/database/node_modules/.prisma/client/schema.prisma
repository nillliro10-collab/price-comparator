// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -----------------------------------------------------------------------------
// 1. Catálogo Base Canónico
// -----------------------------------------------------------------------------

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  brandId     String
  categoryId  String?
  name        String // ej. "Air Force 1 '07"
  model       String // ej. "Air Force 1"
  slug        String   @unique
  description String?
  gender      String?  @default("UNISEX")
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  variants Variant[]

  @@index([brandId])
  @@index([categoryId])
}

// -----------------------------------------------------------------------------
// 2. Variantes (Donde ocurre el verdadero matching)
// -----------------------------------------------------------------------------

model Variant {
  id        String @id @default(uuid())
  productId String

  // Representación Original vs Normalizada
  colorRaw        String? // ej. "Triple White"
  colorNormalized String? // ej. "White"

  sizeRaw    String? // ej. "42 EU"
  sizeValue  String? // ej. "42"
  sizeSystem String? // ej. "EU", "US", "UK"

  sku       String? // SKU interno
  gtin      String? // EAN/UPC (Identificador Fuerte)
  mpn       String? // Manufacturer Part Number (Identificador Medio)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  offers  Offer[]

  // Evitar variantes duplicadas dentro del mismo producto basado en la representación normalizada
  @@unique([productId, sizeValue, sizeSystem, colorNormalized])
  // Índices vitales para el ProductMatchingService
  @@index([gtin])
  @@index([mpn])
  @@index([sku])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// 3. Ofertas y Tiendas (El núcleo del comparador)
// -----------------------------------------------------------------------------

model Store {
  id                  String  @id @default(uuid())
  name                String
  slug                String  @unique
  websiteUrl          String
  shopScore           Int     @default(80)
  logoUrl             String?
  isAffiliate         Boolean @default(true)
  isActive            Boolean @default(true)
  syncEnabled         Boolean @default(true)
  syncInterval        Int     @default(360) // En minutos. Ej: 360 = 6h
  consecutiveFailures Int     @default(0) // Contador de fallos consecutivos
  expirationDays      Int     @default(7) // Ciclo de vida de la oferta para esta tienda
  integrationType     String  @default("CUSTOM") // CSV, XML, JSON, API, AFFILIATE, CUSTOM

  // Affiliate & Commercial
  affiliateNetwork String? // ej. "AWIN", "TRADEDOUBLER", "AMAZON"
  programId        String? // ID de la tienda en la red
  trackingEnabled  Boolean @default(false)
  deeplinkTemplate String? // ej. "https://awin.com/click?id={programId}&url={encodedUrl}&clickref={clickId}"

  isDemo               Boolean   @default(false)
  lastSuccessfulSyncAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  offers     Offer[]
  rawOffers  RawOffer[]
  syncRuns   SyncRun[]
  syncErrors SyncError[]
}

model SyncRun {
  id         String @id @default(uuid())
  storeId    String
  sourceType String
  status     String @default("PENDING") // PENDING, RUNNING, SUCCESS, PARTIAL_SUCCESS, FAILED

  itemsReceived  Int @default(0)
  itemsProcessed Int @default(0)
  itemsCreated   Int @default(0)
  itemsUpdated   Int @default(0)
  itemsFailed    Int @default(0)
  errorCount     Int @default(0) // Mantiene contabilidad rapida

  // Quality Metrics
  missingSkuCount   Int @default(0)
  invalidPriceCount Int @default(0)
  outOfStockCount   Int @default(0)

  durationMs Int?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  store      Store       @relation(fields: [storeId], references: [id])
  syncErrors SyncError[]
}

model SyncError {
  id         String   @id @default(uuid())
  syncRunId  String
  storeId    String
  externalId String?
  errorCode  String
  message    String
  rawPayload String?
  createdAt  DateTime @default(now())

  syncRun SyncRun @relation(fields: [syncRunId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])
}

model Offer {
  id                String @id @default(uuid())
  variantId         String
  storeId           String
  externalProductId String // ID del producto en la tienda
  externalVariantId String @default("") // ID de la talla. Obligatorio por restricción Unique.
  url               String // Enlace de compra (con tracking afiliado)

  // Modelo de Precios Correcto
  priceBase     Float
  priceShipping Float?
  priceTotal    Float?
  currency      String @default("EUR")

  status      String @default("ACTIVE") // ACTIVE, STALE, EXPIRED, DISABLED
  stockStatus String @default("IN_STOCK")

  // Estado y Freshness
  needsManualReview Boolean  @default(false)
  lastSeenAt        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant      Variant        @relation(fields: [variantId], references: [id])
  store        Store          @relation(fields: [storeId], references: [id])
  priceHistory PriceHistory[]

  // IDEMPOTENCIA
  @@unique([storeId, externalProductId, externalVariantId])
  @@unique([storeId, variantId])
  @@index([variantId])
  @@index([storeId])
  @@index([priceTotal])
}

// -----------------------------------------------------------------------------
// PRICE HISTORY
// -----------------------------------------------------------------------------
model PriceHistory {
  id            String   @id @default(uuid())
  offerId       String
  priceBase     Float
  priceShipping Float?
  priceTotal    Float?
  currency      String   @default("EUR")
  recordedAt    DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([recordedAt])
}

// -----------------------------------------------------------------------------
// 4. Ingestión (Buffer antes del Matching)
// -----------------------------------------------------------------------------

model RawOffer {
  id                String  @id @default(uuid())
  storeId           String
  syncRunId         String?
  externalId        String
  externalVariantId String  @default("")

  rawTitle String
  rawBrand String?
  rawColor String?
  rawSize  String?
  rawGtin  String?
  rawMpn   String?
  rawSku   String?
  url      String

  // Modelo de Precios Correcto
  price    Float
  shipping Float?
  stock    String?

  rawPayload String // Usar stringify de JSON

  status          String @default("PENDING")
  similarityScore Float? // Puntuación de confianza del algoritmo (0-1)

  // Telemetría de Matching
  matchingMethod String? // Ej: FUZZY, GTIN, MPN_BRAND
  matchedBy      String? // Nombre del motor/regla
  confidence     String? // HIGH, MEDIUM, LOW

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  // Idempotencia de ingesta raw
  @@unique([storeId, externalId, externalVariantId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// 5. Analytics, Tracking & Monetization
// -----------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(uuid()) // This will serve as our clickId for outbound clicks
  type      String // SEARCH, PRODUCT_VIEW, VARIANT_SELECT, OFFER_VIEW, OUTBOUND_CLICK
  sessionId String?
  productId String?
  variantId String?
  offerId   String?
  storeId   String?
  metadata  String? // JSON con búsqueda, clickId, tracking config
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

// -----------------------------------------------------------------------------
// 6. Matching Review Queue
// -----------------------------------------------------------------------------

model MatchingDecision {
  id                 String  @id @default(uuid())
  rawOfferId         String
  candidateProductId String?
  confidenceScore    Float?
  confidenceLevel    String // HIGH, MEDIUM, LOW
  signals            String // JSON string of matching signals
  reason             String // GTIN_EXACT, MPN_EXACT, FUZZY, CONFLICT_SIZE, etc.
  decision           String  @default("PENDING") // PENDING, APPROVED, REJECTED

  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([decision])
  @@index([confidenceLevel])
}

// -----------------------------------------------------------------------------
// 7. Commercial & Affiliate Conversions
// -----------------------------------------------------------------------------

model AffiliateConversion {
  id      String  @id @default(uuid())
  network String // Awin, TradeDoubler, Amazon, etc.
  storeId String
  offerId String?
  clickId String // Matches AnalyticsEvent.id

  externalTransactionId String? @unique
  status                String  @default("PENDING") // PENDING, CONFIRMED, REJECTED, CANCELLED

  orderValue Float?
  commission Float?
  currency   String @default("EUR")

  occurredAt  DateTime // When the purchase happened
  confirmedAt DateTime? // When the network validated the commission
  rawPayload  String? // JSON string of the webhook payload for auditing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clickId])
  @@index([storeId])
  @@index([status])
}
