generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
}

model Product {
  id          String    @id @default(uuid())
  brandId     String
  categoryId  String?
  name        String
  model       String
  slug        String    @unique
  description String?
  gender      String?   @default("UNISEX")
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])
  brand       Brand     @relation(fields: [brandId], references: [id])
  variants    Variant[]

  @@index([brandId])
  @@index([categoryId])
}

model Variant {
  id              String   @id @default(uuid())
  productId       String
  colorRaw        String?
  colorNormalized String?
  sizeRaw         String?
  sizeValue       String?
  sizeSystem      String?
  sku             String?
  gtin            String?
  mpn             String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          Offer[]
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([productId, sizeValue, sizeSystem, colorNormalized])
  @@index([gtin])
  @@index([mpn])
  @@index([sku])
  @@index([productId])
}

model Store {
  id                   String      @id @default(uuid())
  name                 String
  slug                 String      @unique
  websiteUrl           String
  feedUrl              String?
  shopScore            Int         @default(80)
  logoUrl              String?
  isAffiliate          Boolean     @default(true)
  isActive             Boolean     @default(true)
  syncEnabled          Boolean     @default(true)
  syncInterval         Int         @default(360)
  consecutiveFailures  Int         @default(0)
  expirationDays       Int         @default(7)
  integrationType      String      @default("CUSTOM")
  affiliateNetwork     String?
  programId            String?
  trackingEnabled      Boolean     @default(false)
  deeplinkTemplate     String?
  isDemo               Boolean     @default(false)
  lastSuccessfulSyncAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  offers               Offer[]
  rawOffers            RawOffer[]
  syncErrors           SyncError[]
  syncRuns             SyncRun[]
}

model SyncRun {
  id                String      @id @default(uuid())
  storeId           String
  sourceType        String
  status            String      @default("PENDING")
  itemsReceived     Int         @default(0)
  itemsProcessed    Int         @default(0)
  itemsCreated      Int         @default(0)
  itemsUpdated      Int         @default(0)
  itemsFailed       Int         @default(0)
  errorCount        Int         @default(0)
  missingSkuCount   Int         @default(0)
  invalidPriceCount Int         @default(0)
  outOfStockCount   Int         @default(0)
  durationMs        Int?
  startedAt         DateTime    @default(now())
  finishedAt        DateTime?
  syncErrors        SyncError[]
  store             Store       @relation(fields: [storeId], references: [id])
}

model SyncError {
  id         String   @id @default(uuid())
  syncRunId  String
  storeId    String
  externalId String?
  errorCode  String
  message    String
  rawPayload String?
  createdAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id])
  syncRun    SyncRun  @relation(fields: [syncRunId], references: [id])
}

model Offer {
  id                String         @id @default(uuid())
  variantId         String
  storeId           String
  externalProductId String
  externalVariantId String         @default("")
  url               String
  priceBase         Float
  priceShipping     Float?
  priceTotal        Float?
  currency          String         @default("EUR")
  status            String         @default("ACTIVE")
  stockStatus       String         @default("IN_STOCK")
  needsManualReview Boolean        @default(false)
  lastSeenAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  store             Store          @relation(fields: [storeId], references: [id])
  variant           Variant        @relation(fields: [variantId], references: [id])
  priceHistory      PriceHistory[]

  @@unique([storeId, externalProductId, externalVariantId])
  @@unique([storeId, variantId])
  @@index([variantId])
  @@index([storeId])
  @@index([priceTotal])
}

model PriceHistory {
  id            String   @id @default(uuid())
  offerId       String
  priceBase     Float
  priceShipping Float?
  priceTotal    Float?
  currency      String   @default("EUR")
  recordedAt    DateTime @default(now())
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([recordedAt])
}

model RawOffer {
  id                String   @id @default(uuid())
  storeId           String
  syncRunId         String?
  externalId        String
  externalVariantId String   @default("")
  rawTitle          String
  rawBrand          String?
  rawColor          String?
  rawSize           String?
  rawGtin           String?
  rawMpn            String?
  rawSku            String?
  url               String
  price             Float
  shipping          Float?
  stock             String?
  rawPayload        String
  status            String   @default("PENDING")
  similarityScore   Float?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  confidence        String?
  matchedBy         String?
  matchingMethod    String?
  store             Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, externalId, externalVariantId])
  @@index([status])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  sessionId String?
  productId String?
  variantId String?
  offerId   String?
  storeId   String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
}

model MatchingDecision {
  id                 String    @id @default(uuid())
  rawOfferId         String
  candidateProductId String?
  confidenceScore    Float?
  confidenceLevel    String
  signals            String
  reason             String
  decision           String    @default("PENDING")
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([decision])
  @@index([confidenceLevel])
}

model AffiliateConversion {
  id                    String    @id @default(uuid())
  network               String
  storeId               String
  offerId               String?
  clickId               String
  externalTransactionId String?   @unique
  status                String    @default("PENDING")
  orderValue            Float?
  commission            Float?
  currency              String    @default("EUR")
  occurredAt            DateTime
  confirmedAt           DateTime?
  rawPayload            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([clickId])
  @@index([storeId])
  @@index([status])
}
