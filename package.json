{
  "name": "price-comparator-monorepo",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npx prisma generate --schema=packages/database/prisma/schema.prisma",
    "build": "npm run db:generate && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "npx prisma generate --schema=packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2"
  }
}

// force vercel build
